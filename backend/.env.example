# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=baby_data

# Optional full connection string (overrides all POSTGRES_* values above)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/baby_data

# Security
SECRET_KEY=your-very-secure-secret-key-change-this-in-production

# Redis (optional)
REDIS_URL=redis://localhost:6379

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Built frontend bundle served at the same origin as the API.
# Defaults to <repo>/frontend/build; only set this if the build lives elsewhere.
# FRONTEND_DIST=

# Timezone
TIMEZONE=Australia/Sydney
